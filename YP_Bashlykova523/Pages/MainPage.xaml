<Page x:Class="YP_Bashlykova523.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP_Bashlykova523.Pages"
      mc:Ignorable="d" 
      Background="#D2E2EC"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Row="0" Grid.Column="0" Source="\Images\logoIzba.png" Height="85" Width="85" Margin="15,10,10,10" VerticalAlignment="Top"/>

        <TextBlock Text="Изба-читальня®" Style="{StaticResource HeaderText}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>

        <Border x:Name="freezePanel" Grid.Row="0" Grid.Column="2" Padding="12,6" CornerRadius="10" Background="#D2A8A2" BorderBrush="#3A2119" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,30,0" MinWidth="200" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="applicationTBl" Text="ВЫ ЗАМОРОЖЕНЫ!" FontSize="16" VerticalAlignment="Center" Foreground="#3A2119" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="applicationBtn" Grid.Column="1" Content="Подать заявку" Background="#989876" Margin="10,0,0,0" Height="28" Click="applicationBtn_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
            <Button x:Name="entrBtn" Content="Войти" Background="#9CB97E" Click="entrBtn_Click"/>
            <Button x:Name="logoutBtn" Content="→ Выход" Background="#D2685B" Margin="10,0,0,0" Click="logoutBtn_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="#D9CBC2" BorderBrush="#5A3E36" BorderThickness="4" CornerRadius="0,20,20,0" Padding="0,10" MinWidth="110" MaxWidth="160">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="15">
                <Button x:Name="bookCatalogBtn" Style="{StaticResource SidebarBtn}" Background="#B39075" ToolTip="Каталог" Margin="0,0,0,10" Click="bookCatalogBtn_Click">
                    <Image Source="\Images\bookCatalog.png" Height="37" Width="37"/>
                </Button>

                <Button x:Name="bookListsBtn" Style="{StaticResource SidebarBtn}" Background="#8C6F7D" ToolTip="Списки" Margin="0,0,0,25" Click="bookListsBtn_Click">
                    <Image Source="\Images\lists.png" Height="45" Width="45"/>
                </Button>

                <Button x:Name="adminBtn" Style="{StaticResource SidebarBtn}" Background="#7A8C74" ToolTip="Администрирование" Margin="0,0,0,10" Click="adminBtn_Click">
                    <Image Source="\Images\admin.png" Height="35" Width="35"/>
                </Button>

                <Button x:Name="authorBtn" Style="{StaticResource SidebarBtn}" Background="#A67C73" ToolTip="Автор" Margin="0,0,0,35" Click="authorBtn_Click">
                    <Image Source="\Images\authorProfile.png" Height="40" Width="40"/>
                </Button>

                <Button x:Name="profileBtn" Style="{StaticResource SidebarBtn}" Background="#687FA1" ToolTip="Профиль" Click="profileBtn_Click">
                    <Image Source="\Images\userProfile.png" Height="37" Width="37"/>
                </Button>
            </StackPanel>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="20,0,20,20" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
