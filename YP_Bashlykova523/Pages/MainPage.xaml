<Page x:Class="YP_Bashlykova523.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP_Bashlykova523.Pages"
      mc:Ignorable="d" 
      Background="#D2E2EC"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Row="0" Grid.Column="0" Source="\Images\logoIzba.png" Height="85" Width="85" Margin="20,5,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Читай, Пиши и не спиши®" Style="{StaticResource HeaderText}" Margin="0,48,0,0"/>

        <Border Grid.Row="1" Grid.Column="0" Background="#D9CBC2" BorderBrush="#5A3E36" BorderThickness="4" CornerRadius="0,20,20,0" Padding="0,10">
            <StackPanel VerticalAlignment="Top" Margin="20,10,10,10">
                <Button x:Name="bookCatalogBtn" Style="{StaticResource SidebarBtn}" Background="#6B7A8F" ToolTip="Каталог" Margin="0,0,0,5" Click="bookCatalogBtn_Click">
                    <Image Source="\Images\catalog.png" Style="{StaticResource IconImage}"/>
                </Button>

                <Button x:Name="bookListsBtn" Style="{StaticResource SidebarBtn}" Background="#8C6F7D" ToolTip="Списки" Margin="0,0,0,15" Click="bookListsBtn_Click">
                    <Image Source="\Images\lists.png" Height="35" Width="35"/>
                </Button>

                <Button x:Name="adminBtn" Style="{StaticResource SidebarBtn}" Background="#7A8C74" ToolTip="Администрирование" Margin="0,0,0,5" Click="adminBtn_Click">
                    <Image Source="\Images\admin.png" Height="35" Width="35"/>
                </Button>

                <Button x:Name="authorBtn" Style="{StaticResource SidebarBtn}" Background="#A67C73" ToolTip="Автор" Margin="0,0,0,30" Click="authorBtn_Click">
                    <Image Source="\Images\authorProfile.png" Style="{StaticResource IconImage}"/>
                </Button>

                <Button x:Name="profileBtn" Style="{StaticResource SidebarBtn}" Background="#8B8FA3" ToolTip="Профиль" Click="profileBtn_Click">
                    <Image Source="\Images\userProfile.png" Style="{StaticResource IconImage}"/>
                </Button>
            </StackPanel>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Column="1" Grid.Row="1" Margin="15,0,0,0" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
