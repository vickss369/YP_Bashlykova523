<Page x:Class="YP_Bashlykova523.Pages.accountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YP_Bashlykova523.Pages"
      mc:Ignorable="d" 
      Background="#D2E2EC"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="accountPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">
            <TextBlock Text="Информация" Style="{StaticResource HeaderText}" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Имя пользователя:" FontSize="18"/>
                <TextBlock x:Name="userFullNameTB" FontSize="17" Margin="5,0,0,15"/>

                <TextBlock Text="E-mail:" FontSize="18"/>
                <TextBlock x:Name="emailTB" FontSize="17" Margin="5,0,0,15"/>

                <TextBlock Text="Логин:" FontSize="18"/>
                <TextBlock x:Name="loginTB" FontSize="17" Margin="5,0,0,10"/>

                <TextBlock Text="Роль:" FontSize="18"/>
                <TextBlock x:Name="roleTB" FontSize="17" Margin="5,0,0,15"/>

                <Border x:Name="toBeAuthorPanel" Grid.Row="0" Grid.Column="2" Padding="12,6" CornerRadius="10" Background="#9EBE93" BorderBrush="#3A2119" BorderThickness="1" VerticalAlignment="Center" Margin="0,20,30,0" MinWidth="200">
                    <StackPanel>
                        <TextBlock x:Name="becomeAuthorTBl" Text="Хотите стать автором?" FontSize="17" VerticalAlignment="Center"/>
                        <Button x:Name="applicationAuthorBtn" Grid.Column="1" Content="Подать заявку" Background="#A47F91" Margin="10,8,0,8" Height="28" Click="applicationAuthorBtn_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="МОИ ОТЗЫВЫ" Style="{StaticResource HeaderText}" Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,15"/>

            <ListBox x:Name="reviewsList" Grid.Row="1"  BorderThickness="0" Background="#D2E2EC" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="30,5,5,5" Padding="10" BorderBrush="#3A2119" BorderThickness="1" CornerRadius="8" Background="#D9CBC2">
                            <StackPanel>
                                <TextBlock Text="{Binding Book.Title}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Rating, StringFormat=Оценка: {0}/10}" Margin="0,3,0,3"/>
                                <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
